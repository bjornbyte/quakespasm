{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Linux Debug",
            "description": "Debug build using default compiler (GCC)",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/out/x64/linux/gcc/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Linux Release",
            "description": "Release build using default compiler (GCC)",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/out/x64/linux/gcc/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Linux Clang Debug",
            "description": "Debug build using Clang",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/out/x64/linux/clang/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Linux Clang Release",
            "description": "Release build using Clang",
            "inherits": "linux-base",
            "binaryDir": "${sourceDir}/out/x64/linux/clang/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "windows-msvc-base",
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "msvc-x64-debug",
            "displayName": "MSVC x64 Debug",
            "description": "Debug build using MSVC (64-bit)",
            "inherits": "windows-msvc-base",
            "binaryDir": "${sourceDir}/out/x64/windows/msvc/debug",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-x64-debug-no-ab",
            "displayName": "MSVC x64 Debug no AccelByte GAME SDK",
            "description": "Debug build using MSVC (64-bit)",
            "inherits": "windows-msvc-base",
            "binaryDir": "${sourceDir}/out/x64/windows/msvc/debug",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "USE_ACCELBYTE_GAMESDK": "OFF"
            }
        },
        {
            "name": "msvc-x64-release",
            "displayName": "MSVC x64 Release",
            "description": "Release build using MSVC (64-bit)",
            "inherits": "windows-msvc-base",
            "binaryDir": "${sourceDir}/out/x64/windows/msvc/release",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-x86-debug",
            "displayName": "MSVC x86 Debug",
            "description": "Debug build using MSVC (32-bit)",
            "inherits": "windows-msvc-base",
            "binaryDir": "${sourceDir}/out/x86/windows/msvc/debug",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_SIZEOF_VOID_P": "4"
            }
        },
        {
            "name": "msvc-x86-release",
            "displayName": "MSVC x86 Release",
            "description": "Release build using MSVC (32-bit)",
            "inherits": "windows-msvc-base",
            "binaryDir": "${sourceDir}/out/x86/windows/msvc/release",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_SIZEOF_VOID_P": "4"
            }
        },
        {
            "name": "windows-mingw-base",
            "hidden": true,
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "mingw-x64-debug",
            "displayName": "MinGW x64 Debug",
            "description": "Debug build using MinGW-w64 (64-bit)",
            "inherits": "windows-mingw-base",
            "binaryDir": "${sourceDir}/out/x64/windows/mingw/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "mingw-x64-release",
            "displayName": "MinGW x64 Release",
            "description": "Release build using MinGW-w64 (64-bit)",
            "inherits": "windows-mingw-base",
            "binaryDir": "${sourceDir}/out/x64/windows/mingw/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release"
        },
        {
            "name": "msvc-x64-debug",
            "configurePreset": "msvc-x64-debug"
        },
        {
            "name": "msvc-x64-release",
            "configurePreset": "msvc-x64-release"
        },
        {
            "name": "msvc-x86-debug",
            "configurePreset": "msvc-x86-debug"
        },
        {
            "name": "msvc-x86-release",
            "configurePreset": "msvc-x86-release"
        },
        {
            "name": "mingw-x64-debug",
            "configurePreset": "mingw-x64-debug"
        },
        {
            "name": "mingw-x64-release",
            "configurePreset": "mingw-x64-release"
        }
    ]
}
